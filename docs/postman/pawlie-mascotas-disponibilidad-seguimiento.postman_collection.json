{
  "info": {
    "name": "Pawlie - Mascotas, disponibilidad y seguimiento",
    "description": "Cambia la variable base_url a la URL de Render para probar el backend desplegado. Ejecuta primero la carpeta 0. Requisitos: el cuidador demo debe tener perfil en caregiver_profiles, y para la carpeta 3 la variable requestId debe apuntar a una solicitud en estado ACEPTADA.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Preparación (usuarios y tokens)",
      "item": [
        {
          "name": "Registrar Dueno Demo",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dueno Demo\",\n  \"email\": \"owner@pawlie.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"OWNER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201 o 409\", () => pm.expect([201, 409]).to.include(pm.response.code));"
