# Base de datos (la usan Docker Compose y el backend)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DB_HOST=localhost
DB_PORT=5432

# Base de datos para las pruebas e2e (opcional, por defecto "<POSTGRES_DB>_test")
# POSTGRES_TEST_DB=

# Autenticación: usar una cadena larga y aleatoria, nunca subirla al repo
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Servidor
PORT=3000
# URL del frontend permitida por CORS (separar con comas si son varias)
FRONTEND_URL=http://localhost:3001
DB_SSL=false
